# FundSim Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Supabase (Required) ────────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Vercel Deployment (CI/CD only) ────────────────────────────────────────
# Required only for GitHub Actions auto-deploy to Vercel
# Get VERCEL_TOKEN from vercel.com/account/tokens
# Get ORG_ID and PROJECT_ID from .vercel/project.json after `vercel link`
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id

# Anthropic (FinFox AI tutor)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Stripe billing (FundSim Pro paywall) ──────────────────────────────────
# Required for /api/create-checkout and /api/stripe-webhook to function in
# production. Local dev does not need these — the upgrade button shows an
# error if Stripe isn't configured.
#
# Setup:
#   1. Create a Product → Price in https://dashboard.stripe.com (recurring,
#      e.g. $149/yr). Copy the Price ID (price_...).
#   2. Set the env vars below in Vercel (Settings → Environment Variables).
#   3. In Stripe → Developers → Webhooks → Add endpoint:
#        URL:    https://fundsimulate.com/api/stripe-webhook
#        Events: checkout.session.completed, customer.subscription.deleted
#      Reveal the signing secret → that's STRIPE_WEBHOOK_SECRET.
#   4. Trigger a redeploy in Vercel to pick up the new env vars.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase service-role key — server-only, bypasses RLS to flip is_pro.
# Found in Supabase Dashboard → Settings → API → service_role.
# NEVER expose this to the client. Only the webhook handler uses it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
